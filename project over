def cardiology():
    place=input("Enter your choice of place:")
    print("your guide to cardiology 🫀E")
    wb.open_new_tab(f"https://www.google.com/maps/search/{place}")
    search=f"cardiologist+in+{place}"
    print("showing cardiologist in",(place))
    wb.open_new_tab(f"https://www.google.com/maps/search/{search}")
