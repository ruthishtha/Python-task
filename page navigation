from tkinter import *
from tkinter import messagebox
root = Tk()
root.title("page one")
label = Label(root, text="page one")
label.place(x=20, y=30)
def next_page():
    messagebox.showinfo("Hello", "next page")
    root.destroy()
button=Button (root,text="click me",command=next_page)
button.place(x=20,y=70)
root.mainloop()


